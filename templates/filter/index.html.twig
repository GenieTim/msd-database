{% extends 'base.html.twig' %}

{% block title %}Filter Substances{% if substance %}: {{ substance.name }}{% endif %}{% endblock %}

{% block content %}
    <div class="container my-4">
        {{ form_start(form) }}
        {{ form_widget(form) }}
        {{ form_end(form) }}
    </div>

    <div class="container my-4">
        {% if substance %}
            <div class="row">
                <div class="col-md-8">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2>{{ substance.name }}</h2>
                        <div>
                            {% if substance.id %}
                                <a class="btn btn-outline-danger btn-sm" href="{{ path('substance_label_pdf', {'id': substance.id}) }}" target="_blank">
                                    <i class="fa fa-file-pdf-o"></i> Print GHS Label (PDF)
                                </a>
                                <a class="btn btn-outline-secondary btn-sm" href="{{ path('substance_label_tex', {'id': substance.id}) }}">
                                    <i class="fa fa-code"></i> LaTeX (.tex)
                                </a>
                            {% elseif substance.CASNumber or substance.name %}
                                <a class="btn btn-outline-danger btn-sm" href="{{ path('substance_search_label_pdf', {'search': substance.CASNumber ?: substance.name}) }}" target="_blank">
                                    <i class="fa fa-file-pdf-o"></i> Print GHS Label (PDF)
                                </a>
                                <a class="btn btn-outline-secondary btn-sm" href="{{ path('substance_search_label_tex', {'search': substance.CASNumber ?: substance.name}) }}">
                                    <i class="fa fa-code"></i> LaTeX (.tex)
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <tr>
                                <th style="width: 25%;">Name</th>
                                <td><strong>{{ substance.name }}</strong></td>
                            </tr>
                            {% if substance.formula %}
                                <tr>
                                    <th>Formula</th>
                                    <td><code>{{ substance.formula }}</code></td>
                                </tr>
                            {% endif %}
                            {% if substance.CASNumber %}
                                <tr>
                                    <th>CAS Number</th>
                                    <td>{{ substance.CASNumber }}</td>
                                </tr>
                            {% endif %}
                            {% if substance.molecularWeight %}
                                <tr>
                                    <th>Molecular Weight</th>
                                    <td>{{ substance.molecularWeight }} g/mol</td>
                                </tr>
                            {% endif %}
                            {% if substance.pubchemId %}
                                <tr>
                                    <th>PubChem CID</th>
                                    <td>
                                        <a href="https://pubchem.ncbi.nlm.nih.gov/compound/{{ substance.pubchemId }}" target="_blank">
                                            {{ substance.pubchemId }}
                                        </a>
                                    </td>
                                </tr>
                            {% endif %}
                            {% if substance.signalWord %}
                                <tr>
                                    <th>Signal Word</th>
                                    <td>
                                        <span class="badge {{ signal_word_badge_class(substance.signalWord) }} p-2">
                                            {{ substance.signalWord }}
                                        </span>
                                    </td>
                                </tr>
                            {% endif %}
                            {% if substance.symbols is not empty %}
                                <tr>
                                    <th>GHS Pictograms</th>
                                    <td>
                                        {% for s in substance.symbols %}
                                            <span class="badge {{ symbol_badge_class(s.name) }} mr-1 p-2">
                                                {{ s.name }}
                                            </span>
                                        {% endfor %}
                                    </td>
                                </tr>
                            {% endif %}
                            {% if substance.statements is not empty %}
                                <tr>
                                    <th>GHS Statements</th>
                                    <td>
                                        <ul class="list-unstyled mb-0">
                                            {% for s in substance.statements %}
                                                <li class="mb-1">
                                                    <span class="badge badge-secondary mr-1">{{ s.name }}</span>
                                                    {% if s.description %} : {{ s.description }}{% endif %}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </td>
                                </tr>
                            {% endif %}
                            {% if substance.smiles %}
                                <tr>
                                    <th>SMILES</th>
                                    <td><code>{{ substance.smiles }}</code></td>
                                </tr>
                            {% endif %}
                            {% if substance.inchi %}
                                <tr>
                                    <th>InChI</th>
                                    <td><code>{{ substance.inchi }}</code></td>
                                </tr>
                            {% endif %}
                            {% if substance.inchikey %}
                                <tr>
                                    <th>InChIKey</th>
                                    <td><code>{{ substance.inchikey }}</code></td>
                                </tr>
                            {% endif %}
                            {% if substance.boilingPoint %}
                                <tr>
                                    <th>Boiling Point</th>
                                    <td>{{ substance.boilingPoint }}</td>
                                </tr>
                            {% endif %}
                            {% if substance.meltingPoint %}
                                <tr>
                                    <th>Melting Point</th>
                                    <td>{{ substance.meltingPoint }}</td>
                                </tr>
                            {% endif %}
                            {% if substance.density %}
                                <tr>
                                    <th>Density</th>
                                    <td>{{ substance.density }}</td>
                                </tr>
                            {% endif %}
                            {% if substance.wgkGermany is not null %}
                                <tr>
                                    <th>WGK (Germany)</th>
                                    <td>Class {{ substance.wgkGermany }}</td>
                                </tr>
                            {% endif %}
                            {% if substance.synonyms is not empty %}
                                <tr>
                                    <th>Synonyms</th>
                                    <td>
                                        <div style="max-height: 120px; overflow-y: auto;">
                                            {% for syn in substance.synonyms|slice(0, 15) %}
                                                <span class="badge badge-light border text-dark mr-1 mb-1">{{ syn }}</span>
                                            {% endfor %}
                                        </div>
                                    </td>
                                </tr>
                            {% endif %}
                            {% if substance.source %}
                                <tr>
                                    <th>Data Source</th>
                                    <td>
                                        <a href="{{ substance.source }}" target="_blank" rel="noopener noreferrer">
                                            {{ substance.source }}
                                        </a>
                                    </td>
                                </tr>
                            {% endif %}
                        </table>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">2D Chemical Structure</h5>
                        </div>
                        <div class="card-body text-center">
                            {% set structUrl = substance_structure_url(substance, 280) %}
                            {% if structUrl %}
                                <img src="{{ structUrl }}" alt="{{ substance.name }} structure" class="img-fluid rounded border" style="max-height: 280px;" />
                            {% else %}
                                <div class="text-muted p-4 border rounded bg-light">
                                    <p class="mb-0">2D preview unavailable</p>
                                    <small>{{ substance.formula ?? substance.name }}</small>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="card-title mb-0">API & Integration</h6>
                        </div>
                        <div class="card-body">
                            <p class="small text-muted mb-2">Access this data programmatically:</p>
                            <code>/api/json/substance?search={{ substance.CASNumber ?? substance.name }}</code>
                            <div class="mt-3">
                                <a href="{{ path('api_doc') }}" class="btn btn-outline-info btn-sm btn-block" target="_blank">
                                    View OpenAPI Specs & Documentation
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info" role="alert">
                No substance found for your query. Try searching with a CAS number (e.g. <code>64-17-5</code>), name (e.g. <code>Ethanol</code>), or formula (e.g. <code>C2H6O</code>).
            </div>
        {% endif %}
    </div>
{% endblock %}
