{% extends 'base.html.twig' %}

{% block title %}Substance Search{% if substance %}: {{ substance.name }}{% endif %}{% endblock %}

{% block content %}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h1 class="h4 fw-bold mb-1">Substance Safety Lookup</h1>
                    <p class="text-body-secondary small mb-0">
                        Search across 8 federated chemical safety repositories for GHS classifications, H/P phrases, and physical data.
                    </p>
                </div>
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="input-group input-group-lg">
                    {{ form_widget(form.search) }}
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        Search Substance
                    </button>
                </div>
                {% if not form.search.vars.valid %}
                    <div class="text-danger small mt-2 fw-medium">
                        {{ form_errors(form.search) }}
                    </div>
                {% endif %}
            {{ form_end(form) }}

            <div class="d-flex flex-wrap align-items-center gap-2 mt-3 small">
                <span class="text-body-secondary fw-medium">Quick lookup (Nitric Acid):</span>
                <a href="{{ path('filter', {'simple_search': {'search': 'HNO3'}}) }}" class="badge rounded-pill bg-light text-dark border text-decoration-none px-3 py-1">
                    Formula: HNO<sub>3</sub>
                </a>
                <a href="{{ path('filter', {'simple_search': {'search': '7697-37-2'}}) }}" class="badge rounded-pill bg-light text-dark border text-decoration-none px-3 py-1">
                    CAS: 7697-37-2
                </a>
                <a href="{{ path('filter', {'simple_search': {'search': 'Nitric Acid'}}) }}" class="badge rounded-pill bg-light text-dark border text-decoration-none px-3 py-1">
                    Name: Nitric Acid
                </a>
                <a href="{{ path('filter', {'simple_search': {'search': '944'}}) }}" class="badge rounded-pill bg-light text-dark border text-decoration-none px-3 py-1">
                    PubChem CID: 944
                </a>
            </div>
        </div>
    </div>

    {% if substance %}
        {# Top Substance Identity & Export Header Card #}
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <h2 class="h2 fw-bold mb-0 me-1">{{ substance.name }}</h2>
                            {% if substance.signalWord %}
                                <span class="{{ signal_word_badge_class(substance.signalWord) }} text-uppercase px-3 py-1">
                                    {{ substance.signalWord }}
                                </span>
                            {% endif %}
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            {% if substance.formula %}
                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle fw-semibold px-2 py-1">
                                    Formula: {{ substance.formula|format_formula }}
                                </span>
                            {% endif %}
                            {% if substance.CASNumber %}
                                <span class="badge bg-light text-dark border fw-normal px-2 py-1">
                                    CAS: <strong class="font-monospace">{{ substance.CASNumber }}</strong>
                                </span>
                            {% endif %}
                            {% if substance.molecularWeight %}
                                <span class="badge bg-light text-dark border fw-normal px-2 py-1">
                                    MW: <strong>{{ substance.molecularWeight }} g/mol</strong>
                                </span>
                            {% endif %}
                            {% if substance.wgkGermany is not null %}
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-semibold px-2 py-1">
                                    WGK Germany: Class {{ substance.wgkGermany }}
                                </span>
                            {% endif %}
                            {% if substance.ridadr %}
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle font-monospace px-2 py-1">
                                    {{ substance.ridadr }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2 flex-shrink-0">
                        {% if substance.id %}
                            <a class="btn btn-danger btn-sm px-3 py-2 fw-semibold" href="{{ path('substance_label_pdf', {'id': substance.id}) }}" target="_blank">
                                Print GHS Label (PDF)
                            </a>
                            <a class="btn btn-outline-secondary btn-sm px-3 py-2 fw-medium" href="{{ path('substance_label_tex', {'id': substance.id}) }}">
                                Download LaTeX (.tex)
                            </a>
                        {% elseif substance.CASNumber or substance.name %}
                            <a class="btn btn-danger btn-sm px-3 py-2 fw-semibold" href="{{ path('substance_search_label_pdf', {'search': substance.CASNumber ?: substance.name}) }}" target="_blank">
                                Print GHS Label (PDF)
                            </a>
                            <a class="btn btn-outline-secondary btn-sm px-3 py-2 fw-medium" href="{{ path('substance_search_label_tex', {'search': substance.CASNumber ?: substance.name}) }}">
                                Download LaTeX (.tex)
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            {# Main Column: Safety & Properties #}
            <div class="col-lg-8">
                {# 1. GHS Hazard Classification Card #}
                {% set is_danger = substance.signalWord and ('danger' in substance.signalWord|lower or 'gefahr' in substance.signalWord|lower) %}
                <div class="card {{ is_danger ? 'border-danger-subtle' : 'border-0' }} shadow-sm mb-4">
                    <div class="card-header {{ is_danger ? 'bg-danger-subtle border-danger-subtle' : 'bg-white' }} py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h3 class="h5 fw-bold mb-0 {{ is_danger ? 'text-danger-emphasis' : '' }}">
                            GHS Hazard &amp; Safety Classification
                        </h3>
                        <div class="d-flex align-items-center gap-2">
                            {% if substance.signalWord %}
                                <span class="{{ signal_word_badge_class(substance.signalWord) }} text-uppercase px-2 py-1">
                                    Signal Word: {{ substance.signalWord }}
                                </span>
                            {% endif %}
                            {% if substance.ridadr %}
                                <span class="badge bg-dark text-white font-monospace px-2 py-1">{{ substance.ridadr }}</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="card-body p-4">
                        {% if substance.symbols is not empty %}
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h4 class="h6 text-uppercase text-body-secondary fw-bold small mb-0">GHS Hazard Pictograms</h4>
                                    <span class="badge rounded-pill bg-secondary text-white">{{ substance.symbols|length }}</span>
                                </div>
                                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-2">
                                    {% for s in substance.symbols %}
                                        {% set ghsUrl = ghs_symbol_url(s) %}
                                        {% set ghsCode = ghs_symbol_code(s) ?? s.name %}
                                        {% set ghsDesc = ghs_symbol_description(s) %}
                                        <div class="col">
                                            <div class="d-flex align-items-center gap-3 p-2 rounded-3 border bg-white h-100">
                                                {% if ghsUrl %}
                                                    <img src="{{ ghsUrl }}" alt="{{ ghsCode }} - {{ ghsDesc }}" width="46" height="46" class="flex-shrink-0" />
                                                {% endif %}
                                                <div>
                                                    <span class="badge {{ symbol_badge_class(s.name) }} mb-1">{{ ghsCode }}</span>
                                                    <div class="fw-semibold small text-body lh-sm">{{ ghsDesc }}</div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {% if substance.statements is not empty %}
                            {% set h_statements = [] %}
                            {% set p_statements = [] %}
                            {% set other_statements = [] %}
                            {% for s in substance.statements %}
                                {% if s.type == 2 or (s.name and s.name starts with 'H') %}
                                    {% set h_statements = h_statements|merge([s]) %}
                                {% elseif s.type == 1 or (s.name and s.name starts with 'P') %}
                                    {% set p_statements = p_statements|merge([s]) %}
                                {% else %}
                                    {% set other_statements = other_statements|merge([s]) %}
                                {% endif %}
                            {% endfor %}

                            {% if h_statements is not empty %}
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h4 class="h6 text-uppercase text-body-secondary fw-bold small mb-0">
                                            Hazard Statements (H-Phrases)
                                        </h4>
                                        <span class="badge rounded-pill bg-danger text-white">{{ h_statements|length }}</span>
                                    </div>
                                    <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                                        {% for s in h_statements %}
                                            <div class="list-group-item d-flex align-items-baseline gap-3 py-2 px-3">
                                                <span class="badge bg-danger text-white font-monospace flex-shrink-0 text-center" style="min-width: 4.5rem;">{{ s.name }}</span>
                                                <span class="small text-body">{{ s.description ?: 'Standard GHS hazard statement ' ~ s.name }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            {% if p_statements is not empty %}
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h4 class="h6 text-uppercase text-body-secondary fw-bold small mb-0">
                                            Precautionary Statements (P-Phrases)
                                        </h4>
                                        <span class="badge rounded-pill bg-primary text-white">{{ p_statements|length }}</span>
                                    </div>
                                    <div class="list-group list-group-flush border rounded-3 overflow-auto" style="max-height: 220px;">
                                        {% for s in p_statements %}
                                            <div class="list-group-item d-flex align-items-baseline gap-3 py-2 px-3">
                                                <span class="badge bg-primary text-white font-monospace flex-shrink-0 text-center" style="min-width: 7rem;">{{ s.name }}</span>
                                                <span class="small text-body">{{ s.description ?: 'Follow standard laboratory precautionary procedures for ' ~ s.name }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    {% if p_statements|length > 5 %}
                                        <div class="small text-body-secondary mt-1">
                                            Showing {{ p_statements|length }} precautionary statements (scroll list to inspect all P-phrases).
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if other_statements is not empty %}
                                <div class="mt-3">
                                    <h4 class="h6 text-uppercase text-body-secondary fw-bold small mb-2">Additional Safety Statements</h4>
                                    <div class="list-group list-group-flush border rounded-3">
                                        {% for s in other_statements %}
                                            <div class="list-group-item d-flex align-items-baseline gap-3 py-2 px-3">
                                                <span class="badge bg-secondary text-white font-monospace flex-shrink-0">{{ s.name }}</span>
                                                <span class="small text-body">{{ s.description }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                {# 2. Physical & Chemical Properties Card #}
                {% if substance.molecularWeight or substance.boilingPoint or substance.meltingPoint or substance.density or substance.wgkGermany is not null %}
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h3 class="h5 fw-bold mb-0">Physical &amp; Environmental Properties</h3>
                        </div>
                        <div class="card-body p-4">
                            <div class="row row-cols-2 row-cols-md-4 g-3">
                                {% if substance.molecularWeight %}
                                    <div class="col">
                                        <div class="p-3 rounded-3 bg-body-tertiary border h-100">
                                            <div class="small text-body-secondary mb-1">Molecular Weight</div>
                                            <div class="fw-bold">{{ substance.molecularWeight }} <span class="fw-normal small text-body-secondary">g/mol</span></div>
                                        </div>
                                    </div>
                                {% endif %}
                                {% if substance.meltingPoint %}
                                    <div class="col">
                                        <div class="p-3 rounded-3 bg-body-tertiary border h-100">
                                            <div class="small text-body-secondary mb-1">Melting Point</div>
                                            <div class="fw-bold">{{ substance.meltingPoint }}</div>
                                        </div>
                                    </div>
                                {% endif %}
                                {% if substance.boilingPoint %}
                                    <div class="col">
                                        <div class="p-3 rounded-3 bg-body-tertiary border h-100">
                                            <div class="small text-body-secondary mb-1">Boiling Point</div>
                                            <div class="fw-bold">{{ substance.boilingPoint }}</div>
                                        </div>
                                    </div>
                                {% endif %}
                                {% if substance.density %}
                                    <div class="col">
                                        <div class="p-3 rounded-3 bg-body-tertiary border h-100">
                                            <div class="small text-body-secondary mb-1">Density</div>
                                            <div class="fw-bold">{{ substance.density }}</div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# 3. Chemical Identifiers & Structure Notation Card #}
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h3 class="h5 fw-bold mb-0">Chemical Identifiers &amp; Structure Notation</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th class="ps-4 text-body-secondary fw-medium" style="width: 28%;">Substance Name</th>
                                    <td class="pe-4 fw-semibold">{{ substance.name }}</td>
                                </tr>
                                {% if substance.formula %}
                                    <tr>
                                        <th class="ps-4 text-body-secondary fw-medium">Molecular Formula</th>
                                        <td class="pe-4 fw-semibold">{{ substance.formula|format_formula }}</td>
                                    </tr>
                                {% endif %}
                                {% if substance.CASNumber %}
                                    <tr>
                                        <th class="ps-4 text-body-secondary fw-medium">CAS Registry Number</th>
                                        <td class="pe-4"><span class="font-monospace fw-medium">{{ substance.CASNumber }}</span></td>
                                    </tr>
                                {% endif %}
                                {% if substance.pubchemId %}
                                    <tr>
                                        <th class="ps-4 text-body-secondary fw-medium">PubChem CID</th>
                                        <td class="pe-4">
                                            <a href="https://pubchem.ncbi.nlm.nih.gov/compound/{{ substance.pubchemId }}" target="_blank" rel="noopener noreferrer" class="badge bg-primary text-white text-decoration-none font-monospace px-2 py-1">
                                                CID {{ substance.pubchemId }} ↗
                                            </a>
                                        </td>
                                    </tr>
                                {% endif %}
                                {% if substance.rtecs %}
                                    <tr>
                                        <th class="ps-4 text-body-secondary fw-medium">RTECS Number</th>
                                        <td class="pe-4"><span class="font-monospace">{{ substance.rtecs }}</span></td>
                                    </tr>
                                {% endif %}
                                {% if substance.smiles %}
                                    <tr>
                                        <th class="ps-4 text-body-secondary fw-medium">Canonical SMILES</th>
                                        <td class="pe-4">
                                            <div class="bg-body-tertiary border rounded px-2 py-1 font-monospace small text-break">{{ substance.smiles }}</div>
                                        </td>
                                    </tr>
                                {% endif %}
                                {% if substance.inchikey %}
                                    <tr>
                                        <th class="ps-4 text-body-secondary fw-medium">InChIKey</th>
                                        <td class="pe-4">
                                            <div class="bg-body-tertiary border rounded px-2 py-1 font-monospace small text-break">{{ substance.inchikey }}</div>
                                        </td>
                                    </tr>
                                {% endif %}
                                {% if substance.inchi %}
                                    <tr>
                                        <th class="ps-4 text-body-secondary fw-medium">InChI</th>
                                        <td class="pe-4">
                                            <div class="bg-body-tertiary border rounded px-2 py-1 font-monospace small text-break">{{ substance.inchi }}</div>
                                        </td>
                                    </tr>
                                {% endif %}
                                {% if substance.source %}
                                    <tr>
                                        <th class="ps-4 text-body-secondary fw-medium">Primary Reference Source</th>
                                        <td class="pe-4 small">
                                            {% if substance.source starts with 'http://' or substance.source starts with 'https://' %}
                                                <a href="{{ substance.source }}" target="_blank" rel="noopener noreferrer" class="text-break">
                                                    {{ substance.source }}
                                                </a>
                                            {% else %}
                                                {{ substance.source }}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {# Right Sidebar Column: 2D Structure, Synonyms, API #}
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h3 class="h5 fw-bold mb-0">2D Chemical Structure</h3>
                        {% if substance.formula %}
                            <span class="badge bg-light text-dark border">{{ substance.formula|format_formula }}</span>
                        {% endif %}
                    </div>
                    <div class="card-body p-4 text-center">
                        {% set structUrl = substance_structure_url(substance, 280) %}
                        {% if structUrl %}
                            <div class="bg-white border rounded-3 p-3 mb-2 d-flex align-items-center justify-content-center" style="min-height: 240px;">
                                <img src="{{ structUrl }}" alt="{{ substance.name }} 2D structure" class="img-fluid" style="max-height: 240px;" />
                            </div>
                            <div class="small text-body-secondary">
                                2D depiction rendered via PubChem PUG REST
                            </div>
                        {% else %}
                            <div class="text-body-secondary p-4 border rounded-3 bg-body-tertiary">
                                <p class="fw-medium mb-1">2D Structure Depiction Unavailable</p>
                                <small>{{ substance.formula ? (substance.formula|format_formula) : substance.name }}</small>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {% if substance.synonyms is not empty %}
                    {% set filtered_synonyms = [] %}
                    {% set ignore_list = [
                        (substance.name ?? '')|lower,
                        (substance.CASNumber ?? '')|lower,
                        (substance.formula ?? '')|lower
                    ] %}
                    {% for syn in substance.synonyms %}
                        {% if syn|lower not in ignore_list and filtered_synonyms|length < 24 %}
                            {% set filtered_synonyms = filtered_synonyms|merge([syn]) %}
                        {% endif %}
                    {% endfor %}

                    {% if filtered_synonyms is not empty %}
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                <h3 class="h5 fw-bold mb-0">Synonyms &amp; Identifiers</h3>
                                <span class="badge rounded-pill bg-secondary text-white">{{ substance.synonyms|length }}</span>
                            </div>
                            <div class="card-body p-3">
                                <div class="d-flex flex-wrap gap-1">
                                    {% for syn in filtered_synonyms %}
                                        <span class="badge bg-light text-dark border fw-normal text-wrap text-start px-2 py-1">{{ syn }}</span>
                                    {% endfor %}
                                </div>
                                {% if substance.synonyms|length > filtered_synonyms|length %}
                                    <div class="small text-body-secondary mt-2 pt-2 border-top">
                                        + {{ substance.synonyms|length - filtered_synonyms|length }} additional registry synonyms available via JSON API.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h3 class="h5 fw-bold mb-0">API &amp; Integration</h3>
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-body-secondary mb-2">
                            Fetch this substance's full safety record in JSON or XML format:
                        </p>
                        <div class="bg-dark text-light rounded-2 p-2 font-monospace small text-break mb-3">
                            GET /api/json/substance?search={{ substance.CASNumber ?? substance.name }}
                        </div>
                        <div class="d-grid gap-2">
                            <a href="{{ path('api_substance', {'format': 'json', 'search': substance.CASNumber ?? substance.name}) }}" class="btn btn-primary btn-sm" target="_blank">
                                View Raw JSON Response
                            </a>
                            <a href="{{ path('api_doc') }}" class="btn btn-outline-secondary btn-sm" target="_blank">
                                OpenAPI Specs &amp; Documentation
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    {% else %}
        {% if searched %}
            <div class="card border-warning shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">No Match</span>
                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                No substance found{% if form.search.vars.value %} for “{{ form.search.vars.value }}”{% endif %}
                            </h2>
                            <p class="text-body-secondary mb-3">
                                We queried the local database and upstream chemical registries (PubChem, ECHA, GESTIS, NIST, ChEBI, CompTox, Wikidata, Sigma-Aldrich) but could not find a matching record. Verify the spelling or try searching with one of the supported identifier formats below:
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="{{ path('filter', {'simple_search': {'search': 'HNO3'}}) }}" class="btn btn-outline-primary btn-sm">
                                    Try Formula: HNO3
                                </a>
                                <a href="{{ path('filter', {'simple_search': {'search': '7697-37-2'}}) }}" class="btn btn-outline-primary btn-sm">
                                    Try CAS: 7697-37-2
                                </a>
                                <a href="{{ path('filter', {'simple_search': {'search': 'Nitric Acid'}}) }}" class="btn btn-outline-primary btn-sm">
                                    Try Name: Nitric Acid
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-primary text-white mb-2">1 · Chemical Name</span>
                            <h2 class="h6 fw-bold">Search by IUPAC or Common Name</h2>
                            <p class="small text-body-secondary mb-3">
                                Enter systematic IUPAC nomenclature, common laboratory names, or commercial trade synonyms in English or German.
                            </p>
                        </div>
                        <div class="bg-body-tertiary border rounded p-2 small">
                            <span class="text-body-secondary d-block mb-1" style="font-size: 0.75rem;">Accepted formats:</span>
                            <span class="font-monospace">Nitric Acid</span> · <span class="font-monospace">Aqua fortis</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-success text-white mb-2">2 · Registry Number</span>
                            <h2 class="h6 fw-bold">Search by CAS Number or CID</h2>
                            <p class="small text-body-secondary mb-3">
                                Use a hyphenated CAS Registry Number or numeric PubChem Compound ID (CID) for unambiguous substance resolution.
                            </p>
                        </div>
                        <div class="bg-body-tertiary border rounded p-2 small">
                            <span class="text-body-secondary d-block mb-1" style="font-size: 0.75rem;">Accepted formats:</span>
                            <span class="font-monospace">7697-37-2</span> · <span class="font-monospace">CID 944</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-dark text-white mb-2">3 · Molecular Formula</span>
                            <h2 class="h6 fw-bold">Search by Hill / Empirical Formula</h2>
